            FROM poa_OtrasPartidas a
            INNER JOIN enc_Programatico ep USING( gpo_id,ur_id,epg_id )
            INNER JOIN enc_ClaveFinanciamiento cf using(ecf_id)
            INNER JOIN sinpres.cat_ClaveFinanciamiento2027 USING( fte_id, sft_id, ori_id, sor_id, cfi_id, cfi_anio )
            LEFT JOIN cat_UnidadMedida u ON u.unm_id = a.unm_id
